          "name": "Login to Firstrade",
          "request": {
            "name": "Login to Firstrade",
            "description": {
              "content": "Authenticates a user with username and password. On success returns a session ID (sid) and optionally an ftat cookie. When MFA is required the response includes a t_token and mfa/otp details.",
              "type": "text/plain"
            },
