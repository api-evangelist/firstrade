              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "disabled": false,
                  "key": "username",
                  "value": "<string>",
                  "description": "(Required) Firstrade account username"
                },
                {
                  "disabled": false,
                  "key": "password",
                  "value": "<password>",
                  "description": "(Required) Firstrade account password"
                }
